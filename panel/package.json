{
  "name": "panel",
  "version": "1.0.4",
  "description": "Discord Builds Panel",
  "author": "Discord Builds Panel",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"node server.mjs\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.mjs",
    "electron": "electron .",
    "electron:dev": "yarn build && electron .",
    "dist": "yarn build && electron-builder --win portable",
    "dist:installer": "yarn build && electron-builder --win nsis"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^1.8.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.0.0",
    "components-sdk": "*",
    "concurrently": "^9.1.2",
    "electron": "35.7.5",
    "electron-builder": "^25.1.8",
    "emoji-mart": "^3.0.1",
    "i18next": "^22.4.10",
    "i18next-browser-languagedetector": "^7.0.1",
    "postcss": "^8.5.6",
    "postcss-nesting": "^13.0.1",
    "rc-slider": "^9.7.5",
    "react": "^18.2.0",
    "react-color": "^2.19.3",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^5.0.0",
    "react-i18next": "^12.1.5",
    "react-redux": "^8.0.2",
    "react-select": "^5.10.1",
    "react-textarea-autosize": "^8.3.4",
    "typescript": "^5.9.0",
    "use-file-picker": "^2.1.2",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.discordbuilds.panel",
    "productName": "Discord Builds Panel",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "electronVersion": "35.7.5",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DiscordBuildsPanel-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "DiscordBuildsPanel.exe"
    }
  }
}
